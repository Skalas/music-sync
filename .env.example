# Credenciales de la app de Spotify (developer.spotify.com/dashboard)
# IMPORTANTE: el Redirect URI debe usar la IP de loopback, NO "localhost"
# (Spotify deshabilitó http://localhost en 2025).
SPOTIPY_CLIENT_ID=tu_client_id_aqui
SPOTIPY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080

# Credenciales de la app Tidal (developer.tidal.com/dashboard)
TIDAL_CLIENT_ID=tu_tidal_client_id_aqui
TIDAL_CLIENT_SECRET=tu_tidal_client_secret_aqui
TIDAL_REDIRECT_URI=http://127.0.0.1:8080
