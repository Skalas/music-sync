# Credenciales de la app de Spotify (developer.spotify.com/dashboard)
# IMPORTANTE: el Redirect URI debe usar la IP de loopback, NO "localhost"
# (Spotify deshabilitó http://localhost en 2025).
SPOTIPY_CLIENT_ID=tu_client_id_aqui
SPOTIPY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080

# Credenciales de la app Tidal (developer.tidal.com/dashboard)
# Flujo PKCE de cliente público: NO se usa client secret.
TIDAL_CLIENT_ID=tu_tidal_client_id_aqui
TIDAL_REDIRECT_URI=http://127.0.0.1:8080

# Apple Music API (opcional) — solo para links exactos a canciones en la web app.
# Clave MusicKit (.p8) de developer.apple.com → Certificates, IDs & Profiles → Keys.
# Guarda el .p8 FUERA del repo (p. ej. ~/.config/musicsync/); se expande "~".
APPLE_TEAM_ID=tu_team_id_aqui
APPLE_KEY_ID=tu_key_id_aqui
APPLE_PRIVATE_KEY_PATH=~/.config/musicsync/AuthKey_XXXXXXXXXX.p8
# Storefront del catálogo (código de país ISO, default "us").
APPLE_STOREFRONT=us
